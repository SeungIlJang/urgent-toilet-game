{
  "name": "urgent-toilet-game",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "npm run verify:balance && npm run verify:runtime && npm run verify:release",
    "verify:balance": "node scripts/verify-balance.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:native-assets": "node scripts/verify-native-assets.mjs",
    "verify:economy": "node scripts/verify-economy.mjs",
    "sync:www": "node scripts/sync-www.mjs",
    "shot:store": "node scripts/shot-store.mjs",
    "sfx:build": "node scripts/build-sfx.mjs",
    "build": "npm run verify && vite build && npm run sync:www && npm run verify:economy",
    "build:release": "node scripts/build-release.mjs",
    "android:sync": "npm run build && npx cap sync android && npm run verify:native-assets",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/core": "^7.4.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.14.0",
    "vite": "^7.1.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
